# Data hygiene: no raw store content ever enters this repo (charter §6).
# Root-anchored on purpose: a bare "data/" pattern would also ignore
# src/cortex/data/ — the fingerprints/holdout CONTRACT code (A3a lesson).
/data/
*.db
/datasets/
/artifacts/weights/
*.pt
*.onnx
*.safetensors

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Local env / scratch
.local/
.env
