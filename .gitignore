# Data hygiene: no raw store content ever enters this repo (charter §6).
# Root-anchored on purpose: a bare "data/" pattern would also ignore
# src/cortex/data/ — the fingerprints/holdout CONTRACT code (A3a lesson).
/data/
*.db
/datasets/
/artifacts/weights/
*.pt
*.onnx
*.safetensors

# Model registry (ADR 0003): weights of ARTIFACT revisions are tracked
# under models/ — the canonical artifact lives in git (HF-style, ~98 KB,
# no LFS needed). Training-side weights above stay ignored. Negations sit
# AFTER the blocking patterns to re-include the registry bundles.
!models/
!models/**

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Local env / scratch
.local/
.env
