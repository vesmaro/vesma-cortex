# Data hygiene: no raw store content ever enters this repo (charter §6).
# Root-anchored on purpose: a bare "data/" pattern would also ignore
# src/cortex/data/ — the fingerprints/holdout CONTRACT code (A3a lesson).
/data/
*.db
/datasets/*
# Layer A frozen eval sets (eval-methodology §3; ADR 0003 R2: synthetic
# probe content is committable — no store lines, fingerprinted). The
# corpus-v4 authored batches ride the same rule (wave D4-1: synthetic,
# fingerprinted, disjointness-tested). The rest of datasets/ stays closed.
# Negations sit AFTER the blocking pattern (same idiom as models/ below).
!/datasets/evalsets/
!/datasets/evalsets/**
!/datasets/corpus-v4/
!/datasets/corpus-v4/**
# Near-miss watchlist registry (la4: synthetic eval-surface provenance
# summaries only — no store lines, same ADR 0003 R2 rule as evalsets).
!/datasets/watchlist/
!/datasets/watchlist/**
# dataset-v4.3 wave: the two READMEs are committable (numbers, no record
# text). The parent dir must be re-included first (git cannot re-include
# a file under an excluded dir), and the real-part JSONL is then
# RE-BLOCKED by the later explicit rule at the bottom (last match wins).
!/datasets/v43/
!/datasets/v43/README.md
!/datasets/v43/real-part.README.md
# v4.3 authored translated batches: specs are by-construction content
# (same publication class as corpus-v4 batches — no store text), committable.
!/datasets/corpus-v43/
!/datasets/corpus-v43/**
# real-part record text stays closed (the explicit re-block at the bottom
# targets datasets/v43/real-part.jsonl; corpus-v43 carries no store text).
/artifacts/weights/
*.pt
*.onnx
*.safetensors

# Model registry (ADR 0003): weights of ARTIFACT revisions are tracked
# under models/ — the canonical artifact lives in git (HF-style, ~98 KB,
# no LFS needed). Training-side weights above stay ignored. Negations sit
# AFTER the blocking patterns to re-include the registry bundles.
!models/
!models/**

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Local env / scratch
.local/
.env

# Second block (after the /datasets/v43/ dir negation): the real-part
# JSONL stays local — re-blocked explicitly because the dir negation
# re-includes everything under it (last match wins).
/datasets/v43/real-part.jsonl

# embed-r4 corpus (round-4 embedder KD texts): numbers-only README is
# committable (same class as datasets/v43 READMEs); the jsonl texts stay
# gitignored under data/embed-r4/ (store-derived content).
!/datasets/embed-r4/
!/datasets/embed-r4/README.md

# embed-r4 generation venv (own venv, isolation rule — never another
# product's env) and generation scratch logs
/.venv-r4gen/
